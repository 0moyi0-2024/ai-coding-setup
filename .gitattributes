# 统一换行符规则
* text=auto

# Windows 脚本 - CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.iss  text eol=crlf

# Linux 脚本 - LF
*.sh   text eol=lf

# 文档
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.txt  text eol=lf

# 二进制
*.ico  binary
*.exe  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
*.tar  binary
*.gz   binary
